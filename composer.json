{
    "name": "1a65/gionin-api",
    "description": "Gionin API V1 PHP wrapper",
    "license": "MIT",
    "keywords": ["gionin", "api", "sdk"],
    "authors": [
        {
            "name": "Raphael Giovanini",
            "email": "raphaelgiovanini@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "psr/http-client": "^1.0",
        "psr/http-message": "^2.0",
        "psr/http-factory": "^1.1",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0",
        "nyholm/psr7": "^1.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Gionin\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gionin\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "stan": "phpstan analyse",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    }
}
